<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- Raid/party unit button. Size must match A.RAID_W / A.RAID_H in Raid.lua -->
    <Button name="HUIRaidButtonTemplate" inherits="SecureUnitButtonTemplate" virtual="true">
        <Size>
            <AbsDimension x="72" y="39"/>
        </Size>
        <Attributes>
            <Attribute name="*type1" type="string" value="target"/>
            <Attribute name="*type2" type="string" value="menu"/>
            <Attribute name="shift-type1" type="string" value="focus"/>
        </Attributes>
        <Scripts>
            <OnLoad>
                HUI_InitRaidButton(self)
            </OnLoad>
        </Scripts>
    </Button>
</Ui>
